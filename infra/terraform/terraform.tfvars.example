# Copy to terraform.tfvars (ignored by git) and fill in.

# Your public IP with /32. Find it with: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.7/32"

# Verified in SES (sandbox recipient) and notified by the budget.
alert_email = "you@example.com"

# How GitHub names your repository in OIDC tokens (see the variable description):
#   gh api repos/OWNER/REPO/actions/oidc/customization/sub
# github_oidc_subject_prefix = "repo:owner@123456/name@789012"

# Optional:
# Reuse an Elastic IP you already own instead of creating one (it is taken from the instance that has it).
# existing_eip_allocation_id = "eipalloc-0123456789abcdef0"
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# monthly_budget_usd  = 20
# swap_gb             = 2

# Cloudflare: ids of the zone and the account (not secret). The API token goes in the CLOUDFLARE_API_TOKEN
# environment variable, never here.
cloudflare_zone_id    = "00000000000000000000000000000000"
cloudflare_account_id = "00000000000000000000000000000000"
