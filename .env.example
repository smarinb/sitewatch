# Copy to .env (git-ignored) and fill in. docker compose reads it automatically;
# for ./mvnw spring-boot:run, export it first: set -a; source .env; set +a

# Base64 HMAC key for signing JWTs, at least 32 bytes: openssl rand -base64 32
JWT_SECRET=
# Token lifetime as an ISO-8601 duration (optional, default PT24H)
# JWT_TTL=PT24H
# Comma-separated origins allowed to call the API (optional, default http://localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Alerts ---------------------------------------------------------------
# SMTP for email alerts. Without SPRING_MAIL_HOST the email channel is off.
# Local development: docker compose up -d mailpit, then use localhost:1025
# and read the emails at http://localhost:8025
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=Sitewatch <alerts@monitor.sergiomarin.dev>
# Telegram bot token from @BotFather. Without it the Telegram channel is off.
# TELEGRAM_BOT_TOKEN=

# Public demo mode (leave unset for local development).
# REGISTRATION_ENABLED=false     closes sign-up
# DEMO_EMAIL=demo@sergiomarin.dev   account the "Try the demo" button signs in as (read-only)
