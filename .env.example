# Copy to .env (git-ignored) and fill in. docker compose reads it automatically;
# for ./mvnw spring-boot:run, export it first: set -a; source .env; set +a

# Base64 HMAC key for signing JWTs, at least 32 bytes: openssl rand -base64 32
JWT_SECRET=
# Token lifetime as an ISO-8601 duration (optional, default PT24H)
# JWT_TTL=PT24H
# Comma-separated origins allowed to call the API (optional, default http://localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173
